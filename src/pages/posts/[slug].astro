---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE, CATEGORIES } from '../../consts';

export async function getStaticPaths() {
  const entries = await getCollection('posts', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry, all: entries } }));
}

const { entry, all } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const url = new URL(`/posts/${entry.id}/`, Astro.site).href;
const lawyerId = new URL('/#lawyer', Astro.site).href;
const published = data.pubDate;
const modified = data.updatedDate ?? data.pubDate;
const fmt = (d: Date) => `${d.getFullYear()}년 ${d.getMonth() + 1}월 ${d.getDate()}일`;
// 같은 분야 글을 먼저, 부족하면 다른 분야로 채웁니다 (내부링크 = 주제 클러스터)
const others = all.filter((p) => p.id !== entry.id);
const related = [
  ...others.filter((p) => p.data.category === data.category),
  ...others.filter((p) => p.data.category !== data.category),
].slice(0, 3);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    '@id': `${url}#article`,
    url,
    headline: data.title,
    description: data.description,
    inLanguage: 'ko-KR',
    articleSection: CATEGORIES[data.category],
    image: new URL('/og.jpg', Astro.site).href,
    datePublished: published.toISOString(),
    dateModified: modified.toISOString(),
    author: { '@id': lawyerId },
    publisher: { '@id': lawyerId },
    isPartOf: { '@id': new URL('/#website', Astro.site).href },
    citation: data.sources.map((s) => s.url),
  },
  ...(data.faqs.length
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          mainEntity: data.faqs.map((f) => ({
            '@type': 'Question',
            name: f.q,
            acceptedAnswer: { '@type': 'Answer', text: f.a },
          })),
        },
      ]
    : []),
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE.name, item: Astro.site?.href },
      { '@type': 'ListItem', position: 2, name: '글', item: new URL('/posts/', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: data.title, item: url },
    ],
  },
];
---

<BaseLayout title={data.seoTitle} description={data.description} ogType="article" jsonLd={jsonLd}>
  <article class="wrap narrow article">
    <header class="article-head">
      <p class="crumbs"><a href="/posts/">글</a> · <a href={`/posts/#${data.category}`}>{CATEGORIES[data.category]}</a></p>
      <h1>{data.title}</h1>
      <p class="byline">
        <a href="/#profile">{SITE.name}</a> · 대한변협 등록 형사법 전문 ·
        <time datetime={modified.toISOString().slice(0, 10)}>{fmt(modified)}</time>
      </p>
    </header>

    <p class="answer" set:html={data.answer.split('\n').join('<br />')} />

    <div class="prose">
      <Content />
    </div>

    {data.faqs.length > 0 && (
      <section class="faq">
        <h2>자주 묻는 질문</h2>
        {data.faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </section>
    )}

    <aside class="author-box" aria-label="글쓴이">
      <img src="/profile.jpg" width="72" height="90" alt="" loading="lazy" />
      <div>
        <p><a href="/#profile">{SITE.name}</a> · {SITE.lawyer.firm}</p>
        <p class="note">상담한 변호사가 조사와 재판까지 직접 책임집니다. 내 사건이 지금 어느 단계인지 확인이 필요하면 전화 주세요.</p>
        <a class="btn btn-primary" href={`tel:${SITE.phone}`} data-track="call_click" data-place="article">{SITE.phone}</a>
      </div>
    </aside>

    {data.sources.length > 0 && (
      <section class="sources">
        <h2>근거 법령</h2>
        <ul>
          {data.sources.map((s) => (
            <li><a href={s.url} rel="noopener" target="_blank">{s.title}</a></li>
          ))}
        </ul>
      </section>
    )}

    {related.length > 0 && (
      <section class="related">
        <h2>함께 읽으면 좋은 글</h2>
        <ul>
          {related.map((p) => (
            <li><a href={`/posts/${p.id}/`}>{p.data.title}</a></li>
          ))}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>
