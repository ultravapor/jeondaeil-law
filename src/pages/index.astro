---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, CATEGORIES } from '../consts';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => (b.data.updatedDate ?? b.data.pubDate).valueOf() - (a.data.updatedDate ?? a.data.pubDate).valueOf(),
);

// 화면의 FAQ와 FAQPage JSON-LD가 같은 배열을 씁니다 (거짓 구조화 데이터 방지).
const faqs = [
  {
    q: '형사 변호사는 언제 선임하는 것이 좋나요?',
    a: '가능하면 첫 경찰 조사 전에 선임하는 것이 좋습니다. 첫 조사에서 한 진술이 이후 수사와 재판의 방향을 정하는 경우가 많고, 한 번 남은 조서는 나중에 바로잡기 어렵기 때문입니다.',
  },
  {
    q: '경찰 조사에 변호사가 함께 들어갈 수 있나요?',
    a: '네. 피의자는 신문을 받을 때 변호인의 참여를 요청할 수 있습니다(형사소송법 제243조의2). 저는 조사 전에 진술 방향을 함께 정리하고, 조사에 직접 참여합니다.',
  },
  {
    q: '상담은 사무장이 하나요, 변호사가 하나요?',
    a: '상담은 전대일 변호사가 직접 합니다. 상담한 변호사가 조사 참여, 서면, 재판까지 책임지고 진행합니다. 처음 사건을 들은 변호사가 끝까지 맡아야 맥락이 끊기지 않기 때문입니다. 세무·회계처럼 다른 전문성이 필요한 부분은 협업하는 전문가와 함께 봅니다.',
  },
  {
    q: '억울하게 성범죄로 고소당했는데, 무혐의를 받을 수 있나요?',
    a: '상담 전에는 누구도 장담할 수 없습니다. 고소인 진술이 객관적 자료와 어디서 어긋나는지, 내 진술이 처음부터 일관됐는지가 결과를 가릅니다. 첫 상담에서 그 지점을 먼저 확인해 드립니다.',
  },
  {
    q: '첫 상담 전에 무엇을 준비하면 되나요?',
    a: '출석요구 문자나 통지서, 사건 경위를 시간 순서로 적은 메모, 상대방과 주고받은 메시지나 통화 기록, 전과가 있다면 그 내용을 준비해 주세요. 불리하다고 생각되는 내용도 빼지 않고 말씀해 주셔야 정확한 판단이 가능합니다.',
  },
  {
    q: '지방에서 진행되는 사건도 맡을 수 있나요?',
    a: '서울·수도권 사건이 중심이지만, 지방 사건도 상담하고 수임합니다. 다만 조사 참여나 기록 복사를 위해 이동이 많은 사건은 상담 때 일정과 비용을 먼저 말씀드립니다.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': new URL('/#faq', Astro.site).href,
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];

const consultSteps = [
  { t: '실제 경위', d: '유리한지 불리한지가 아니라, 실제로 무슨 일이 있었는지부터 듣습니다.' },
  { t: '인정 여부', d: '인정할 부분과 다툴 부분을 나눕니다. 모든 것을 부인하는 것이 늘 유리하지는 않습니다.' },
  { t: '진술의 신빙성', d: '고소인 진술과 내 진술이 처음부터 일관됐는지, 객관적 자료와 어디서 충돌하는지 봅니다.' },
  { t: '전과와 양형자료', d: '결과에 영향을 주는 전과, 합의 가능성, 유리한 정상 자료를 확인합니다.' },
  { t: '목표 설정', d: '무혐의·무죄를 다툴지, 처벌을 줄이는 데 집중할지 현실적인 목표를 함께 정합니다.' },
];

const fmt = (d: Date) => `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

<BaseLayout title="형사사건 변호사, 누구에게 맡겨야 할까" description={SITE.description} path="/" jsonLd={jsonLd}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <p class="eyebrow">{SITE.tagline}</p>
        <h1>형사사건,<br />어떤 변호사에게 맡겨야 할까요?</h1>
        <p class="answer">
          상담한 변호사가 조사와 재판까지 직접 하는지 먼저 확인하세요.
        </p>
        <p class="lead">
          상담한 변호사가 경찰 조사 참여, 서면, 재판까지 직접 책임집니다.<br />
          세무·회계처럼 다른 전문성이 필요한 부분은 협업 전문가와 함께 봅니다.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary" href={`tel:${SITE.phone}`} data-track="call_click" data-place="hero">
            전화 상담 {SITE.phone}
          </a>
          <a class="btn btn-ghost" href="#consult">첫 상담에서 하는 일</a>
        </div>
        <p class="hero-meta">대한변호사협회 등록 형사법·손해배상 전문 · 사법시험 51회</p>
      </div>
      <figure class="hero-photo">
        <img src="/profile.jpg" width="720" height="900" alt="전대일 변호사" fetchpriority="high" />
      </figure>
    </div>
  </section>

  <section id="way" class="section">
    <div class="wrap">
      <h2>제가 일하는 방식</h2>
      <p class="section-answer">상담한 변호사가 끝까지 책임지고, 불리한 것부터 말씀드립니다.</p>
      <div class="cards">
        <article class="card">
          <h3>처음 들은 변호사가 끝까지 책임집니다</h3>
          <p>수사 단계에서 의뢰인이 한 말 한마디가 법정에서 중요하게 다뤄지는 경우가 있습니다.</p>
          <p>그 말의 맥락을 아는 변호사가 재판에 들어가야 제대로 대응할 수 있습니다.</p>
          <p>그래서 상담한 변호사가 조사 참여, 서면, 재판까지 직접 챙깁니다.</p>
        </article>
        <article class="card">
          <h3>이길 수 있다고 먼저 말하지 않습니다</h3>
          <p>된다고 먼저 말한 순간부터, 변호사는 의뢰인의 사건이 아니라 자기 말을 지키려고 움직이게 됩니다.</p>
          <p>그래서 첫 상담에서 불리한 부분이 있으면 먼저 말씀드립니다.</p>
          <p>그래야 같은 방향을 보고 싸울 수 있습니다.</p>
        </article>
        <article class="card">
          <h3>필요한 분야는 전문가와 함께 봅니다</h3>
          <p>조세형사 사건은 같은 법인의 공인회계사·세무사 출신 변호사와 세무·형사 양쪽에서 봅니다.</p>
          <p>감정평가, 손해사정, 의료 자문이 필요한 사건도 협업하는 전문가와 함께 검토합니다.</p>
          <p>사건의 방향은 처음 상담한 변호사가 끝까지 잡습니다.</p>
        </article>
      </div>
    </div>
  </section>

  <section id="consult" class="section section-alt">
    <div class="wrap">
      <h2>첫 상담에서 무엇을 하나요?</h2>
      <p class="section-answer">이길 방법을 말하기 전에, 질 수 있는 이유를 먼저 찾습니다.</p>
      <p>어떤 지점이 취약한지, 수사기관이 어디를 파고들지, 고소인 진술과 어디서 충돌하는지를 먼저 봅니다.</p>
      <p>첫 상담은 아래 다섯 단계로 진행합니다.</p>
      <ol class="steps">
        {consultSteps.map((s) => (
          <li>
            <strong>{s.t}</strong>
            <span>{s.d}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="police" class="section">
    <div class="wrap narrow">
      <h2>경찰 조사를 앞두고 있다면</h2>
      <p class="section-answer">첫 조사가 사건의 방향을 정합니다. 가능하면 그 전에 변호인과 진술을 정리하세요.</p>
      <ul class="plain-list">
        <li>첫 조사에 변호인이 참여하는 것이 가장 중요합니다. 이때 남은 조서가 이후 모든 단계의 출발점이 됩니다.</li>
        <li>어설픈 무죄 주장보다, 인정할 것은 인정하고 다툴 부분을 분명히 하는 편이 진술의 신빙성을 지킵니다.</li>
        <li>조사에서 다툰 내용은 충실한 의견서로 뒷받침하고, 합의 등 양형 대비도 함께 준비합니다.</li>
      </ul>
      <p class="example">
        혐의가 성립하는 사건에서 무죄만 주장하다 더 무거운 결과를 받는 경우가 있습니다.
        이럴 때는 인정할 부분은 인정하고, 고소인 주장이 과하거나 이치에 맞지 않는 부분을 양형에서 적극 다투는 편이 나을 수 있습니다.
        무조건 무죄를 주장하는 것보다 더 유리한 방향을 고르는 것이 판단입니다.
      </p>
    </div>
  </section>

  <section id="profile" class="section section-alt">
    <div class="wrap profile-grid">
      <div>
        <h2>전대일 변호사</h2>
        <p class="section-answer">교도관이셨던 아버지를 닮아, 편법보다 정석으로 일합니다.</p>
        <p>정직하게, 정석대로 해도 억울함을 풀고 권리를 찾는 사례가 쌓이면서 이 일이 제 성향에 맞는 직업이라고 생각하게 됐습니다.</p>
        <p>제일 잘한다는 말은 하지 않겠습니다. 다만 의뢰인에게 가장 유리한 길을 찾는 데 가장 신경 쓰겠습니다.</p>
      </div>
      <dl class="career">
        <div><dt>2009</dt><dd>제51회 사법시험 합격</dd></div>
        <div><dt>2011</dt><dd>사법연수원 제41기 수료</dd></div>
        <div><dt>2012–2021</dt><dd>법무법인 나눔 소속 변호사 (기업자문·송무)</dd></div>
        <div><dt>2021–</dt><dd>{SITE.lawyer.firm} 구성원 변호사</dd></div>
        <div><dt>전문분야</dt><dd>대한변호사협회 등록 형사법 · 손해배상</dd></div>
      </dl>
    </div>
  </section>

  <section id="posts" class="section">
    <div class="wrap">
      <h2>사건 유형별 글</h2>
      <p class="section-answer">상담에서 자주 받는 질문을 하나씩 정리해 둡니다.</p>
      <div class="tabs" role="list">
        {Object.entries(CATEGORIES).filter(([key]) => posts.some((p) => p.data.category === key)).map(([key, label]) => (
          <a role="listitem" href={`/posts/#${key}`}>{label}</a>
        ))}
      </div>
      <ul class="post-list">
        {posts.slice(0, 6).map((p) => (
          <li>
            <a href={`/posts/${p.id}/`}>
              <span class="cat">{CATEGORIES[p.data.category]}</span>
              <span class="pt">{p.data.title}</span>
              <time datetime={(p.data.updatedDate ?? p.data.pubDate).toISOString().slice(0, 10)}>
                {fmt(p.data.updatedDate ?? p.data.pubDate)}
              </time>
            </a>
          </li>
        ))}
      </ul>
      <p><a class="more" href="/posts/">글 전체 보기</a></p>
    </div>
  </section>

  <section id="faq" class="section section-alt">
    <div class="wrap narrow">
      <h2>자주 묻는 질문</h2>
      <div class="faq">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section id="contact" class="section contact">
    <div class="wrap narrow">
      <h2>상담 문의</h2>
      <a class="btn btn-primary btn-big" href={`tel:${SITE.phone}`} data-track="call_click" data-place="contact">
        {SITE.phone}
      </a>
      <dl class="contact-info">
        <div><dt>주소</dt><dd>{SITE.address.full}</dd></div>
        <div><dt>소속</dt><dd>{SITE.lawyer.firm}</dd></div>
      </dl>
    </div>
  </section>
</BaseLayout>
